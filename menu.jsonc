  // Actions go through bash twice (the menu, then the launcher's bash -c). The inner
  // double quotes keep the plugin path a single word at the second parse.
  "setup.dgpu": {
    "icon": "󰢮",
    "label": "Discrete GPU",
    "aliases": ["gpu", "nvidia", "dgpu", "prime", "graphics"]
  },
  "setup.dgpu.status": {
    "icon": "󰈻",
    "label": "Power state",
    "action": "/usr/bin/omarchy-launch-floating-terminal-with-presentation '\"@PLUGIN_BIN@/gpuwho\" status'"
  },
  "setup.dgpu.who": {
    "icon": "󰅩",
    "label": "What is using it",
    "action": "/usr/bin/omarchy-launch-floating-terminal-with-presentation '\"@PLUGIN_BIN@/gpuwho\"'"
  },
  "setup.dgpu.watch": {
    "icon": "󰄉",
    "label": "Watch for wakes (60s)",
    "action": "/usr/bin/omarchy-launch-floating-terminal-with-presentation '\"@PLUGIN_BIN@/gpuwho\" watch 60'"
  },
  "setup.dgpu.why": {
    "icon": "󰘥",
    "label": "Why does it wake?",
    "action": "/usr/bin/omarchy-launch-floating-terminal-with-presentation '\"@PLUGIN_BIN@/gpuwho\" why'"
  },
