#!/usr/bin/bash
# gpuwho -- what is keeping the NVIDIA discrete GPU awake. Read-only.
#
# Reads /proc and exactly these sysfs attributes of the PCI device bound to the nvidia
# driver: power_state, power/runtime_status, power/runtime_suspended_time,
# power/runtime_active_time, power/control and d3cold_allowed. The kernel answers those
# from cached state, so reading them never wakes the GPU.
#
# Never add lspci, setpci, nvidia-smi, an open() of /dev/nvidia*, or a read of the
# device's config, current_link_speed or current_link_width: each reaches PCI config
# space or the driver, and the kernel resumes a sleeping card to answer -- the tool would
# manufacture the very wakes it reports.
#
# It writes nothing: no configuration, no wrappers, no launchers, no temporary files.

PATH=/usr/bin
LC_ALL=C
export PATH LC_ALL
set -u
shopt -s nullglob

if [[ -t 1 ]]; then
  c_bold=$'\e[1m' c_dim=$'\e[2m' c_grn=$'\e[32m' c_ylw=$'\e[33m' c_red=$'\e[31m' c_rst=$'\e[0m'
else
  c_bold='' c_dim='' c_grn='' c_ylw='' c_red='' c_rst=''
fi

# ------------------------------------------------------------------ helpers
# clean <var> <text> [max]: printable ASCII only, truncated. Everything that did not come
# from this script (arguments, process names) is printed through this, so it cannot carry
# terminal escape sequences.
clean() {
  local _clean_s=${2:0:${3:-64}}
  printf -v "$1" '%s' "${_clean_s//[^[:print:]]/?}"
}

die() {
  local _msg
  clean _msg "$*" 200
  printf '%serror:%s %s\n' "$c_red" "$c_rst" "$_msg" >&2
  exit 1
}

# ------------------------------------------------------------------ the device
BDF_RE='^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]$'
NV_SYS='' NV_PCI=''

# Resolve the device from the driver's own binding, not a hardcoded address: entries of
# /sys/bus/pci/drivers/nvidia named like a PCI address whose symlink leads to a directory
# of the same name under /sys/devices/. Only directory lookups -- nothing is opened.
resolve_device() {
  local entry name real n=0
  for entry in /sys/bus/pci/drivers/nvidia/*; do
    (( ++n > 256 )) && break
    name=${entry##*/}
    [[ $name =~ $BDF_RE ]] || continue
    real=$(realpath -e -- "$entry" 2>/dev/null) || continue
    [[ $real == /sys/devices/*/"$name" && ! $real =~ [^A-Za-z0-9:._/-] ]] || continue
    [[ -d $real && ! -L $real && -f $real/power_state && ! -L $real/power_state ]] || continue
    NV_SYS=$real NV_PCI=$name
    return 0
  done
  return 1
}

require_device() {
  resolve_device || die "no PCI device is bound to the nvidia driver"
}

# attr <var> <attribute>: one allowlisted power attribute of the device, or '?'.
attr() {
  local _attr_v=''
  case $2 in
    power_state|power/runtime_status|power/runtime_suspended_time|power/runtime_active_time|power/control|d3cold_allowed) ;;
    *) die "internal: refusing to read '$2' (not a power attribute)" ;;
  esac
  if [[ -n $NV_SYS ]]; then
    IFS= read -r -n 32 _attr_v 2>/dev/null < "$NV_SYS/$2" || true
  fi
  [[ $_attr_v =~ ^[A-Za-z0-9_]{1,32}$ ]] || _attr_v='?'
  printf -v "$1" '%s' "$_attr_v"
}

# attr_num <var> <attribute>: a counter attribute as a non-negative integer (0 if unreadable).
attr_num() {
  attr "$1" "$2"
  [[ ${!1} =~ ^[0-9]{1,15}$ ]] || printf -v "$1" '%s' 0
}

# hours <ms>: milliseconds as hours with one decimal, rounded.
hours() {
  local t=$(( ($1 * 10 + 1800000) / 3600000 ))
  printf '%d.%d' $(( t / 10 )) $(( t % 10 ))
}

# Sets SS_CODE (deep|light|active|trans|unknown) and SS_TEXT from power_state and
# runtime_status. D0 = awake, D3hot = light sleep (still powered), D3cold = deep sleep
# (fully powered off -- the real battery win).
sleep_state() {
  local ps rs
  attr ps power_state
  attr rs power/runtime_status
  case $ps in
    D3cold) SS_CODE=deep  SS_TEXT="${c_grn}DEEP sleep (D3cold — fully powered off)${c_rst}" ;;
    D3hot)  SS_CODE=light SS_TEXT="${c_ylw}light sleep (D3hot — powered, idle)${c_rst}" ;;
    D0)
      if [[ $rs == active ]]; then SS_CODE=active SS_TEXT="${c_red}awake (D0 — active)${c_rst}"
      else SS_CODE=trans SS_TEXT="${c_ylw}transitioning (D0/${rs})${c_rst}"; fi ;;
    *) SS_CODE=unknown SS_TEXT="${c_dim}unknown (power_state=${ps})${c_rst}" ;;
  esac
}

has_nvpcf() { [[ -d /sys/bus/acpi/devices/NVDA0820:00 ]]; }

# ------------------------------------------------------------------ processes
# HOLDERS: pids (ascending) with an fd open on /dev/nvidia*. Only the link targets under
# /proc/<pid>/fd are read -- the device nodes themselves are never opened. Bounded by a
# deadline; other users' processes are invisible without root.
scan_holders() {
  HOLDERS=()
  local -A seen=()
  local dir pid
  local procs=(/proc/[0-9]*/fd)
  (( ${#procs[@]} )) || return 0
  while IFS= read -r -d '' dir; do
    pid=${dir#/proc/}
    pid=${pid%/fd}
    [[ $pid =~ ^[0-9]{1,10}$ ]] && seen[$pid]=1
  done < <(timeout -k 1 10 find "${procs[@]}" -mindepth 1 -maxdepth 1 -lname '/dev/nvidia*' -printf '%h\0' 2>/dev/null)
  (( ${#seen[@]} )) || return 0
  mapfile -t HOLDERS < <(printf '%s\n' "${!seen[@]}" | sort -n)
}

# proc_comm <var> <pid>: the process name, restricted to a plain character set. It is also
# used as an associative-array key, so nothing with shell meaning may survive.
proc_comm() {
  local _comm=''
  IFS= read -r -n 64 _comm 2>/dev/null < "/proc/$2/comm" || true
  _comm=${_comm:0:32}
  _comm=${_comm//[^A-Za-z0-9._:+@\/ -]/?}
  printf -v "$1" '%s' "${_comm:-?}"
}

# fd_counts <pid>: FD_NV = fds on /dev/nvidia*, FD_IGPU = fds on renderD128/card1.
fd_counts() {
  FD_NV=0 FD_IGPU=0
  local t
  while IFS= read -r -d '' t; do
    case $t in
      /dev/nvidia*) FD_NV=$(( FD_NV + 1 )) ;;
      *renderD128*|*card1*) FD_IGPU=$(( FD_IGPU + 1 )) ;;
    esac
  done < <(timeout -k 1 5 find "/proc/$1/fd" -mindepth 1 -maxdepth 1 -printf '%l\0' 2>/dev/null)
}

# ------------------------------------------------------------------ who / status / sleep
cmd_who() {
  [[ -e /dev/nvidia0 ]] || die "no /dev/nvidia0 (is the NVIDIA driver loaded?)"
  resolve_device || true
  sleep_state
  printf '%sProcesses on the NVIDIA dGPU%s %s—%s %s\n' "$c_bold" "$c_rst" "$c_dim" "$c_rst" "$SS_TEXT"
  scan_holders
  if (( ${#HOLDERS[@]} == 0 )); then
    printf '  %snothing is using the dGPU%s — it can sleep.\n' "$c_grn" "$c_rst"
    return 0
  fi
  printf '  %s%-8s %-22s %-7s %s%s\n' "$c_dim" PID COMMAND NV-FDS MODE "$c_rst"
  local pid comm mode
  for pid in "${HOLDERS[@]}"; do
    [[ -d /proc/$pid ]] || continue
    proc_comm comm "$pid"
    fd_counts "$pid"
    if timeout -k 1 5 grep -qE '/dev/nvidia[0-9]' "/proc/$pid/maps" 2>/dev/null; then
      mode="${c_red}rendering${c_rst}"
    elif (( FD_IGPU > 0 )); then
      mode="${c_ylw}holding (renders on Intel)${c_rst}"
    else
      mode="${c_dim}holding${c_rst}"
    fi
    printf '  %-8s %-22s %-7s %s\n' "$pid" "${comm:0:22}" "$FD_NV" "$mode"
  done
  echo
  printf "  %s'rendering' processes keep the dGPU awake; it can sleep once they exit.%s\n" "$c_dim" "$c_rst"
}

cmd_status() {
  require_device
  local st ctrl d3 ps asleep awake total pct
  attr st power/runtime_status
  attr ctrl power/control
  attr d3 d3cold_allowed
  attr ps power_state
  attr_num asleep power/runtime_suspended_time
  attr_num awake power/runtime_active_time
  sleep_state
  total=$(( asleep + awake ))
  if (( total > 0 )); then pct=$(( (200 * asleep / total + 1) / 2 )); else pct='?'; fi
  printf '%sdGPU power%s (%s)\n' "$c_bold" "$c_rst" "$NV_PCI"
  printf '  runtime_status : %s\n' "$st"
  printf '  power/control  : %s        %s(auto = RTD3 allowed)%s\n' "$ctrl" "$c_dim" "$c_rst"
  printf '  d3cold_allowed : %s\n' "$d3"
  printf '  power_state    : %s   %s(D0 awake / D3hot light / D3cold deep)%s\n' "$ps" "$c_dim" "$c_rst"
  printf '  right now      : %s\n' "$SS_TEXT"
  printf '  asleep         : %s h\n' "$(hours "$asleep")"
  printf '  awake          : %s h\n' "$(hours "$awake")"
  printf '  %sasleep %s%% of the time%s  %s(higher = more battery saved)%s\n' \
    "$c_bold" "$pct" "$c_rst" "$c_dim" "$c_rst"
}

# Quick one-liner; exit status 0 iff the dGPU is in deep sleep (scriptable).
cmd_sleep() {
  require_device
  local ps rs
  sleep_state
  attr ps power_state
  attr rs power/runtime_status
  printf 'dGPU: %s  %s[power_state=%s, runtime=%s]%s\n' "$SS_TEXT" "$c_dim" "$ps" "$rs" "$c_rst"
  [[ $SS_CODE == deep ]]
}

# ------------------------------------------------------------------ watch
# Attribute dGPU wakes to the process that caused them, from power_state and /proc only.
#
# A compositor keeps /dev/nvidia* open from login to logout, so "who holds it at wake time"
# would name it for EVERY wake. Residents are snapshotted up front and only newcomers are
# reported as suspects. Tallies live in associative arrays -- nothing touches the disk.
#
# NVPCF (ACPI HID NVDA0820) is how the embedded controller negotiates power and thermal
# budget with the GPU. A firmware Notify on it makes the driver take a runtime-PM
# reference, so the card powers up with no process behind it -- invisible to any fd scan.
declare -A TALLY=() RESIDENT=()
W_START=0 W_PREV='' W_WAKES=0 W_AWAKE=0 W_WSTART=0 W_MISSED=0

watch_summary() {
  trap - INT TERM
  local total=$(( EPOCHSECONDS - W_START )) name t
  if [[ $W_PREV == D0 ]] && (( W_WSTART != 0 )); then
    W_AWAKE=$(( W_AWAKE + EPOCHSECONDS - W_WSTART ))
    W_WSTART=0
  fi
  echo
  printf '%ssummary%s %sover %ss%s\n' "$c_bold" "$c_rst" "$c_dim" "$total" "$c_rst"
  printf '  wakes        : %s\n' "$W_WAKES"
  printf '  awake        : %ss' "$W_AWAKE"
  if (( total > 0 )); then
    t=$(( (2000 * W_AWAKE / total + 1) / 2 ))
    printf '  (%d.%d%% of the window)' $(( t / 10 )) $(( t % 10 ))
  fi
  echo
  # A process polling nvidia-smi on a timer never lets the card idle, so it produces ZERO
  # wake events -- the card simply never sleeps. Counting wakes alone would report that
  # as a quiet, healthy window, which is exactly backwards.
  if (( W_WAKES == 0 && total >= 20 )) && [[ $W_PREV == D0 ]]; then
    echo
    printf '  %sThe dGPU never slept during this window.%s\n' "$c_red" "$c_rst"
    printf '  %sZero wakes here does not mean idle — it means something is HOLDING the card,\n' "$c_dim"
    printf '  not waking it. A holder shows no wake events at all, so watching for wakes will\n'
    printf '  never find it. Look for a poller instead:%s\n' "$c_rst"
    printf '    %snvidia-smi on a timer (system-monitor bar widgets are the usual culprit)%s\n' "$c_dim" "$c_rst"
    printf '    %sanything with /dev/nvidia* open: %sgpuwho%s lists them%s\n' "$c_dim" "$c_rst" "$c_dim" "$c_rst"
  fi
  if (( ${#TALLY[@]} )); then
    printf '  %snewly-arrived holders at wake time%s\n' "$c_bold" "$c_rst"
    for name in "${!TALLY[@]}"; do
      printf '    %7d %s\n' "${TALLY["$name"]}" "$name"
    done | sort -rn | head -8
  else
    printf '  %sno holder caught in this window%s\n' "$c_dim" "$c_rst"
    if has_nvpcf; then
      printf '  %sthis machine has an NVPCF device — see %sgpuwho why%s for what that means.%s\n' \
        "$c_dim" "$c_rst" "$c_dim" "$c_rst"
    fi
  fi
  if (( W_MISSED > 0 )); then
    printf '  %s%d wake(s) had no holder%s %s— the process exited between samples.%s\n' \
      "$c_ylw" "$W_MISSED" "$c_rst" "$c_dim" "$c_rst"
    printf '  %scatch them with: GPUWHO_POLL=0.25 gpuwho watch%s\n' "$c_dim" "$c_rst"
  fi
  if (( EUID != 0 )); then
    printf '  %sprocesses of other users (e.g. nvidia-persistenced) are invisible to this scan.%s\n' \
      "$c_dim" "$c_rst"
  fi
}

cmd_watch() {
  local dur=$1 poll=${GPUWHO_POLL:-1} ms ip fp
  [[ $dur =~ ^[0-9]{1,5}$ ]] && (( 10#$dur <= 86400 )) \
    || die "usage: gpuwho watch [seconds]   (0-86400; omit or 0 for until Ctrl-C)"
  dur=$(( 10#$dur ))
  [[ $poll =~ ^([0-9]{1,2})(\.([0-9]{1,3}))?$ ]] \
    || die "GPUWHO_POLL must be a number of seconds between 0.1 and 60"
  ip=${BASH_REMATCH[1]} fp=${BASH_REMATCH[3]}000
  ms=$(( 10#$ip * 1000 + 10#${fp:0:3} ))
  (( ms >= 100 && ms <= 60000 )) || die "GPUWHO_POLL must be a number of seconds between 0.1 and 60"
  printf -v poll '%d.%03d' $(( ms / 1000 )) $(( ms % 1000 ))
  require_device

  local end=0 ps now holders pid comm names
  W_START=$EPOCHSECONDS
  (( dur > 0 )) && end=$(( W_START + dur ))

  printf '%sWatching the dGPU%s %s— poll %ss, sysfs only (does not wake it)%s\n' "$c_bold" "$c_rst" "$c_dim" "$poll" "$c_rst"
  if (( end != 0 )); then names="for ${dur}s"; else names="until Ctrl-C"; fi
  printf '%s%s · a wake shows what held /dev/nvidia* at that moment%s\n\n' "$c_dim" "$names" "$c_rst"

  trap 'watch_summary; exit 0' INT TERM

  # The starting state is a BASELINE, not a wake: opening the window while the GPU happens
  # to be awake would otherwise count as a wake with no holder.
  attr W_PREV power_state
  scan_holders
  for pid in "${HOLDERS[@]}"; do
    proc_comm comm "$pid"
    RESIDENT["$comm"]=1
  done
  if (( ${#RESIDENT[@]} )); then
    names=$(printf '%s\n' "${!RESIDENT[@]}" | sort | tr '\n' ' ')
    printf '  %sresident holders (open /dev/nvidia* for the whole session): %s%s\n' "$c_dim" "${names% }" "$c_rst"
  fi
  printf -v now '%(%H:%M:%S)T' -1
  if [[ $W_PREV == D0 ]]; then
    W_WSTART=$W_START
    printf '  %s  %s%-7s%s %s(already awake when watching started — baseline, not a wake)%s\n' \
      "$now" "$c_dim" "$W_PREV" "$c_rst" "$c_dim" "$c_rst"
  else
    printf '  %s  %s%-7s%s %s(baseline)%s\n' "$now" "$c_dim" "$W_PREV" "$c_rst" "$c_dim" "$c_rst"
  fi

  while :; do
    attr ps power_state
    if [[ $ps != "$W_PREV" ]]; then
      printf -v now '%(%H:%M:%S)T' -1
      if [[ $ps == D0 ]]; then
        W_WAKES=$(( W_WAKES + 1 ))
        W_WSTART=$EPOCHSECONDS
        local new_h=() res_h=()
        scan_holders
        for pid in "${HOLDERS[@]}"; do
          proc_comm comm "$pid"
          if [[ ${RESIDENT["$comm"]+x} ]]; then
            res_h+=("$comm($pid)")
          else
            new_h+=("$comm($pid)")
            TALLY["$comm"]=$(( ${TALLY["$comm"]:-0} + 1 ))
          fi
        done
        if (( ${#new_h[@]} )); then
          holders="${new_h[*]}"
        elif (( ${#res_h[@]} )); then
          # Only long-lived residents were holding it. One of them may have poked the
          # card, but the fd list cannot say which -- claiming otherwise would be a guess.
          if has_nvpcf; then
            holders="${c_dim}no new process — a short-lived config-space reader or a firmware notify (gpuwho why)${c_rst}"
          else
            holders="${c_dim}only resident holders (${res_h[*]}) — no new process; cause not attributable from fds${c_rst}"
          fi
        else
          W_MISSED=$(( W_MISSED + 1 ))
          holders="${c_dim}<nothing held it — short-lived waker>${c_rst}"
        fi
        printf '  %s  %s%-7s%s %s\n' "$now" "$c_red" "$ps" "$c_rst" "$holders"
      else
        if [[ $W_PREV == D0 ]] && (( W_WSTART != 0 )); then
          W_AWAKE=$(( W_AWAKE + EPOCHSECONDS - W_WSTART ))
          W_WSTART=0
        fi
        local col=$c_grn
        [[ $ps == D3hot ]] && col=$c_ylw
        printf '  %s  %s%-7s%s\n' "$now" "$col" "$ps" "$c_rst"
      fi
      W_PREV=$ps
    fi
    (( end != 0 && EPOCHSECONDS >= end )) && break
    sleep "$poll"
  done
  watch_summary
}

# ------------------------------------------------------------------ why
# Explain wakes that no userspace tool can attribute. The root-only recipes that settle
# the question live in the README ("Diagnosing wakes"); this tool never runs them.
cmd_why() {
  resolve_device || true
  local addr=${NV_PCI:-<pci-address>}
  printf '%sWhy the dGPU wakes with nothing running%s\n\n' "$c_bold" "$c_rst"
  if has_nvpcf; then
    cat <<EOS
  This laptop exposes ${c_bold}NVDA0820${c_rst} (NVPCF) — the ACPI interface the embedded
  controller uses to negotiate power and thermal budget with the GPU.

  When the firmware raises a Notify on it, the NVIDIA driver answers like this:
    ${c_dim}acpi_ev_notify_dispatch -> rm_acpi_nvpcf_notify -> os_ref_dynamic_power${c_rst}
    ${c_dim}  -> nv_indicate_not_idle -> __pm_runtime_resume${c_rst}

  nv_indicate_not_idle takes a runtime-PM reference, so the card powers up purely
  to service the notification, then suspends again. ${c_bold}No process is involved${c_rst} —
  which is why fd listings, /proc polling and udev monitoring all come up empty.

  This is the platform working as designed, not a leak. It happens in bursts tied
  to AC/battery, thermal and load changes rather than on a fixed interval.
  ${c_dim}nvidia-powerd does not need to be running for it to occur, and the ~18s tail${c_rst}
  ${c_dim}is not tunable: power/autosuspend_delay_ms returns EIO because the driver${c_rst}
  ${c_dim}does not use the PM core's autosuspend at all.${c_rst}

  ${c_bold}Before blaming firmware, rule out a config-space reader.${c_rst} A desktop shell that
  re-runs hardware probes (menu state, bar widgets) can call ${c_dim}lspci${c_rst} on a loop and
  produce exactly the same symptom — periodic wakes with no lasting process. That
  is far more common, and unlike NVPCF it is fixable. An audit rule on lspci shows
  whether that is happening; the README's "Diagnosing wakes" section has the recipe.
EOS
  else
    printf '  %sNo NVPCF device (NVDA0820) on this machine, so firmware notifies are not%s\n' "$c_dim" "$c_rst"
    printf '  %sthe usual explanation here.%s\n' "$c_dim" "$c_rst"
  fi
  echo
  printf '%sConfirm it yourself%s\n' "$c_bold" "$c_rst"
  [[ -n $NV_PCI ]] || printf '  %sno device is bound to the nvidia driver right now%s\n' "$c_dim" "$c_rst"
  # addr is either a validated PCI address or the fixed placeholder, so it is inert here.
  cat <<EOS
  A kernel tracepoint on runtime-PM resumes, filtered to ${c_bold}${addr}${c_rst}, shows the exact
  call chain behind every wake. It needs root, so this tool does not run it: the recipe
  is in the README under "Diagnosing wakes".
EOS
  cat <<EOS

  ${c_dim}The tracepoint fires inside the kernel, so unlike a /proc poller it cannot be${c_rst}
  ${c_dim}outrun by a short-lived process. The filter field is 'name', not 'dev_name' —${c_rst}
  ${c_dim}getting that wrong silently traces every device instead of just this one.${c_rst}

${c_bold}Other things that genuinely wake it${c_rst}
  ${c_dim}lspci / setpci${c_rst}  read PCI config space; the kernel resumes the card to answer
  ${c_dim}nvidia-smi${c_rst}      talks to the driver directly
  ${c_dim}current_link_speed${c_rst} and other config-space sysfs attributes
  ${c_dim}This tool reads only power_state, power/* and d3cold_allowed, which never wake it.${c_rst}
EOS
}

# ------------------------------------------------------------------ help / dispatch
usage() {
  cat <<'EOF'
gpuwho — what is keeping the NVIDIA discrete GPU awake (read-only)

  gpuwho                 list processes that hold the dGPU open
  gpuwho status          power state, runtime PM settings, time asleep
  gpuwho sleep           is it in deep sleep (D3cold) right now? exit 0 = yes
  gpuwho watch [secs]    log every wake and name what held the GPU (omit: until Ctrl-C)
  gpuwho why             why it can wake with nothing running, and how to trace it
  gpuwho help            this text

  GPUWHO_POLL=<secs>     sampling interval for watch, 0.1 to 60 (default 1)

Reads only /proc and the dGPU's sysfs power attributes, so it never wakes the GPU.
It changes nothing and writes no files.
EOF
}

no_args() {
  (( $1 == 0 )) || die "'$2' takes no arguments (try: gpuwho help)"
}

main() {
  local cmd=${1:-who}
  (( $# > 0 )) && shift
  case $cmd in
    who|ps|list)          no_args $# "$cmd"; cmd_who ;;
    status|state)         no_args $# "$cmd"; cmd_status ;;
    sleep|deep|deepsleep) no_args $# "$cmd"; cmd_sleep ;;
    watch)                (( $# <= 1 )) || die "usage: gpuwho watch [seconds]"; cmd_watch "${1:-0}" ;;
    why|explain)          no_args $# "$cmd"; cmd_why ;;
    help|-h|--help)       no_args $# "$cmd"; usage ;;
    *)                    die "unknown command '$cmd' (try: gpuwho help)" ;;
  esac
}

main "$@"
